# Copia este archivo a `.env` antes de arrancar el backend.

# Base de datos (SQLite para desarrollo). En producción usar PostgreSQL:
# DATABASE_URL="postgresql://user:pass@localhost:5432/medline?schema=public"
DATABASE_URL="file:./dev.db"

# Autenticación
JWT_SECRET="cambia-esta-clave-en-produccion"
JWT_EXPIRES_IN="8h"

# Servidor
PORT=4000
CORS_ORIGIN="http://localhost:5173"
