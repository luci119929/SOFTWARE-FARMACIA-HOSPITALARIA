// MedLine — Esquema de datos (Fase 1: Arquitectura Base)
// Proveedor: SQLite para desarrollo sin configuración. En producción se
// recomienda PostgreSQL (basta con cambiar el datasource). Los campos de tipo
// "enum" se modelan como String con valores validados en la capa de dominio
// (src/domain/enums.ts) para mantener portabilidad con SQLite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 2-3. Autenticación y RBAC
// ---------------------------------------------------------------------------

model Role {
  id          String           @id @default(cuid())
  key         String           @unique // ADMIN, PHARMACY_CHIEF, PHARMACIST, WAREHOUSE, PURCHASING, AUDITOR
  name        String
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // p.ej. "inventory:read", "purchasing:approve"
  module      String // agrupador lógico: inventory, purchasing, audit, users...
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique // Identidad = correo institucional
  passwordHash            String
  fullName                String
  roleId                  String
  role                    Role                     @relation(fields: [roleId], references: [id])
  isActive                Boolean                  @default(true)
  lastLoginAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  movements               Movement[]
  createdPOs              PurchaseOrder[]          @relation("POCreatedBy")
  approvedPOs             PurchaseOrder[]          @relation("POApprovedBy")
  rejectedPOs             PurchaseOrder[]          @relation("PORejectedBy")
  auditEntries            AuditLog[]
  returnsRequested        StockReturn[]            @relation("ReturnRequestedBy")
  returnsProcessed        StockReturn[]            @relation("ReturnProcessedBy")
  clinicalEntriesCreated  ClinicalHistoryEntry[]   @relation("ClinicalEntryCreatedBy")
  clinicalEntriesUpdated  ClinicalHistoryEntry[]   @relation("ClinicalEntryUpdatedBy")
  clinicalVersionsChanged ClinicalHistoryVersion[] @relation("ClinicalVersionChangedBy")
}

// ---------------------------------------------------------------------------
// 4. Inventario y trazabilidad
// ---------------------------------------------------------------------------

model Supplier {
  id             String          @id @default(cuid())
  name           String
  contactName    String? // persona de contacto
  contactEmail   String?
  contactPhone   String?
  address        String?
  taxId          String? // identificación fiscal (CUIT/RUC/NIT)
  paymentTerms   String? // condiciones comerciales, p.ej. "30 días fecha factura"
  notes          String?
  leadTimeDays   Int             @default(7) // TE — Tiempo de Entrega por defecto
  isActive       Boolean         @default(true)
  items          Item[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Item {
  id                     String                 @id @default(cuid())
  // Metadatos del medicamento (sección 4)
  name                   String
  activeIngredient       String
  manufacturer           String
  presentation           String
  concentration          String
  therapeuticCategory    String
  // Clasificación farmacológica (sección 6)
  abcClassification      String // A | B | C
  venClassification      String // V | E | N
  // Almacenamiento y cadena de frío
  storageCondition       String // AMBIENT | REFRIGERATED
  // Parámetros logísticos para el Motor de Compra (sección 9.1)
  minimumThreshold       Int                    @default(0) // umbral de stock crítico
  maxStorageCapacity     Int                    @default(0) // capacidad máxima (unidades) en destino
  moq                    Int                    @default(1) // Lote Mínimo de Compra
  leadTimeDaysOverride   Int? // TE específico del ítem (sobrescribe el del proveedor)
  supplierId             String?
  supplier               Supplier?              @relation(fields: [supplierId], references: [id])
  batches                Batch[]
  movements              Movement[]
  alerts                 Alert[]
  poLines                PurchaseOrderLine[]
  returns                StockReturn[]
  clinicalHistoryEntries ClinicalHistoryEntry[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
}

// Lote físico — habilita FEFO y el cálculo de Stock Útil vs. En Riesgo
model Batch {
  id               String        @id @default(cuid())
  itemId           String
  item             Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batchNumber      String
  expirationDate   DateTime // ISO-8601
  availableQty     Int           @default(0)
  physicalLocation String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  returns          StockReturn[]

  @@unique([itemId, batchNumber])
}

// ---------------------------------------------------------------------------
// 5. Libro mayor de movimientos (event-driven, append-only en la práctica)
// ---------------------------------------------------------------------------

model Movement {
  id                  String   @id @default(cuid())
  timestamp           DateTime @default(now())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  itemId              String
  item                Item     @relation(fields: [itemId], references: [id])
  batchId             String?
  quantityDelta       Int // positivo = entrada, negativo = salida
  movementType        String // ENTRY | EXIT | ADJUSTMENT | RETURN | INTERNAL_TRANSFER
  sourceLocation      String?
  destinationLocation String?
  note                String?
}

// ---------------------------------------------------------------------------
// 8. Alertas automatizadas
// ---------------------------------------------------------------------------

model Alert {
  id         String    @id @default(cuid())
  itemId     String
  item       Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type       String // CRITICAL_STOCK | EXPIRY_RISK | COLD_CHAIN_BREACH | ANOMALOUS_CONSUMPTION
  severity   String // INFO | WARNING | CRITICAL
  message    String
  status     String    @default("OPEN") // OPEN | ACKNOWLEDGED | RESOLVED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

// ---------------------------------------------------------------------------
// 9. Motor de compra inteligente
// ---------------------------------------------------------------------------

model PurchaseOrder {
  id              String              @id @default(cuid())
  code            String              @unique // p.ej. PO-2026-0001
  status          String              @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | RECEIVED | CANCELLED
  supplierId      String?
  supplier        Supplier?           @relation(fields: [supplierId], references: [id])
  createdById     String
  createdBy       User                @relation("POCreatedBy", fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User?               @relation("POApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectedById    String?
  rejectedBy      User?               @relation("PORejectedBy", fields: [rejectedById], references: [id])
  rejectedAt      DateTime?
  rejectionReason String?
  receivedAt      DateTime?
  lines           PurchaseOrderLine[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item          @relation(fields: [itemId], references: [id])
  recommendedQty  Int // cantidad sugerida por el motor (EOQ ajustado)
  orderedQty      Int // cantidad final tras aprobación / consolidación
  receivedQty     Int           @default(0) // acumulado recibido (soporta recepciones parciales)
  unitCost        Float? // costo pactado/real capturado al recibir
  rationale       String? // trazabilidad del cálculo (PP, SS, CDP...)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([purchaseOrderId, itemId]) // antiduplicidad a nivel de línea
}

// ---------------------------------------------------------------------------
// 12. Registro de auditoría inmutable (append-only)
// ---------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(cuid())
  timestamp     DateTime @default(now())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  actionType    String // CREATE | UPDATE | DELETE | LOGIN | APPROVE | RECOMMEND ...
  module        String
  entity        String?
  entityId      String?
  previousValue String? // JSON serializado (Valor Anterior)
  newValue      String? // JSON serializado (Nuevo Valor)
  ipAddress     String? // IP del cliente al momento de la acción
  userAgent     String? // User-Agent del cliente
  roleKey       String? // rol del usuario AL MOMENTO de la acción (puede cambiar después)
}

// ---------------------------------------------------------------------------
// Devoluciones y logística inversa
// ---------------------------------------------------------------------------

model StockReturn {
  id                  String    @id @default(cuid())
  code                String    @unique // p.ej. RET-2026-000123
  itemId              String
  item                Item      @relation(fields: [itemId], references: [id])
  batchId             String?
  batch               Batch?    @relation(fields: [batchId], references: [id])
  quantity            Int
  reason              String // RETURN_REASONS
  disposition         String? // RETURN_DISPOSITIONS — se define al procesar
  status              String    @default("PENDING") // RETURN_STATUSES
  sourceLocation      String? // de dónde vuelve (piso/servicio)
  requestedById       String
  requestedBy         User      @relation("ReturnRequestedBy", fields: [requestedById], references: [id])
  processedById       String?
  processedBy         User?     @relation("ReturnProcessedBy", fields: [processedById], references: [id])
  processedAt         DateTime?
  resultingMovementId String? // Movement generado si disposition=RESTOCK
  note                String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Historia clínica orientada a farmacia — pacientes, prescripciones y notas
// asociadas a la dispensación. No reemplaza al HIS del hospital (diagnósticos
// clínicos completos, resultados de laboratorio, etc.), sólo lleva el
// registro que la farmacia necesita para justificar y trazar lo que dispensa.
// ---------------------------------------------------------------------------

model Patient {
  id          String                 @id @default(cuid())
  mrn         String                 @unique // Número de historia clínica (Medical Record Number)
  fullName    String
  dateOfBirth DateTime
  sex         String // PATIENT_SEX: M | F | X
  weightKg    Float? // peso (kg)
  heightM     Float? // altura (m)
  allergies   String? // texto libre — alergias conocidas, chequeo obligatorio antes de prescribir
  notes       String? // observaciones clínicas importantes
  entries     ClinicalHistoryEntry[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

// Entrada de historia clínica. Refleja siempre el estado ACTUAL; el historial
// de versiones previas vive en ClinicalHistoryVersion (sección 12-bis).
model ClinicalHistoryEntry {
  id            String                   @id @default(cuid())
  patientId     String
  patient       Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  entryType     String // CLINICAL_ENTRY_TYPES: DIAGNOSIS | PRESCRIPTION | NOTE | ALLERGY_UPDATE
  title         String
  description   String
  relatedItemId String? // p.ej. el medicamento prescripto, si entryType=PRESCRIPTION
  relatedItem   Item?                    @relation(fields: [relatedItemId], references: [id])
  // Sólo aplican cuando entryType=PRESCRIPTION (medicamento actual).
  dose          String? // p.ej. "50 mg"
  frequency     String? // p.ej. "1 vez al día"
  startDate     DateTime? // desde cuándo lo toma — para calcular "hace X tiempo"
  version       Int                      @default(1) // se incrementa en cada UPDATE
  createdById   String
  createdBy     User                     @relation("ClinicalEntryCreatedBy", fields: [createdById], references: [id])
  updatedById   String?
  updatedBy     User?                    @relation("ClinicalEntryUpdatedBy", fields: [updatedById], references: [id])
  versions      ClinicalHistoryVersion[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
}

// Versionado de cambios (sección "Historia Clínica"): antes de sobreescribir
// una entrada, se guarda una foto completa del estado anterior. A diferencia
// del AuditLog genérico (que guarda un diff previousValue→newValue), esto
// permite reconstruir y mostrar el contenido íntegro de cualquier versión
// pasada sin tener que recomponerlo a partir de una cadena de diffs.
model ClinicalHistoryVersion {
  id            String               @id @default(cuid())
  entryId       String
  entry         ClinicalHistoryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  version       Int // número de la versión que este registro representa (el estado PREVIO al cambio)
  entryType     String
  title         String
  description   String
  relatedItemId String?
  dose          String?
  frequency     String?
  startDate     DateTime?
  changedById   String // quién hizo el cambio que dio origen a esta versión archivada
  changedBy     User                 @relation("ClinicalVersionChangedBy", fields: [changedById], references: [id])
  changedAt     DateTime             @default(now())

  @@unique([entryId, version])
}
